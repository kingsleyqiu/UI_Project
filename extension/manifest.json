{
  "manifest_version": 3,
  "name": "Pizza Assistant — Group 10",
  "version": "0.1.0",
  "description": "An English voice/text assistant for three Domino's Canada pizzas. Every change needs your confirmation. Checkout stays with you.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "offscreen"],
  "host_permissions": ["https://www.dominos.ca/*", "https://dominos.ca/*", "http://127.0.0.1:8787/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Pizza Assistant microphone setup" },
  "content_scripts": [{
    "matches": ["https://www.dominos.ca/*", "https://dominos.ca/*"],
    "js": ["bootstrap.js"],
    "run_at": "document_idle"
  }],
  "web_accessible_resources": [{
    "resources": ["content.js", "panel.js", "planner.js", "cart.js", "site.js", "avatar.svg"],
    "matches": ["https://www.dominos.ca/*", "https://dominos.ca/*"]
  }]
}
